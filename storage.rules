rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.uid == 'Ke4wsFZkboOLInp9oS9KMj2QGqg1' ||
        request.auth.uid == 'y7IaZyd6LdPbFPnoGhmC0nSpzhG2'
      );
    }
  }
}

